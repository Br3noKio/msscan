#!/usr/sbin/nft -f
# MSscan — o navegador do quiosque (usuário msscan-ui) só pode falar com o próprio servidor.
#
# O Firefox abre conexões por conta própria (configurações remotas, push da Mozilla...) mesmo com
# as preferências de user.js desligando esses serviços. Esta regra é a garantia: qualquer destino
# fora de 127.0.0.1/::1, inclusive DNS, é recusado. O Python do MSscan (root) não é afetado.
# Validado no QEMU (kernel 6.12 do trixie): loopback passa; internet e DNS não; root segue normal.
# Aplicada pelo msscan-iniciar antes de abrir o navegador; se falhar, a interface não sobe.
# Bloqueio SEMPRE com REJECT (TCP: reset; o resto: ICMP), nunca DROP: o programa recebe a recusa na hora em vez de
# esperar um timeout (CLAUDE.md 15.1).

table inet msscan_quiosque
delete table inet msscan_quiosque

# Entrada: a porta do pareamento do celular (chave da IA, CLAUDE.md 10d) fica FECHADA; o MSscan a abre só durante um
# pareamento, pondo a porta no conjunto "pareamento" com timeout de 5 min (fecha sozinha mesmo se o MSscan cair):
#   nft add element inet msscan_quiosque pareamento '{ 47443 timeout 300s }'
# Nada mais muda na entrada.
#
# Navegador integrado (fase 11, usuário msscan-web): só alcança o proxy do MSscan (127.0.0.1:47480), que só abre
# túneis HTTPS para os domínios oficiais (Dell, HPE, Lenovo), e a interface (127.0.0.1:8765, para "Voltar ao
# MSscan"). Nem DNS ele faz: quem resolve os nomes é o proxy. O navegador do quiosque (msscan-ui) não usa o proxy.

table inet msscan_quiosque {
	set pareamento {
		type inet_service
		flags timeout
	}

	# Repositório da atualização pelo iDRAC (CLAUDE.md 18.7): porta 80 aberta só durante a atualização (o MSscan põe a
	# porta neste conjunto com timeout) e só para quem chega pela rede interna do OS to iDRAC Pass-through.
	set repositorio {
		type inet_service
		flags timeout
	}

	# 22.2: repositório pela rede local (iDRAC na mesma rede do servidor): só o IP do iDRAC, só a porta do repositório e só
	# durante a atualização (elemento "IP . porta" com timeout).
	set repositorio_lan {
		type ipv4_addr . inet_service
		flags timeout
	}

	# 22.5: SSH (desligado por padrão). Ao ativar, o MSscan põe aqui a rede local do servidor (ex.: 192.168.0.0/24) com
	# timeout; ao desativar, apaga. Sem elemento, a porta 22 fica fechada para todos.
	set ssh_redes {
		type ipv4_addr
		flags interval, timeout
	}

	chain entrada {
		type filter hook input priority filter; policy accept;
		tcp dport @pareamento accept
		tcp dport 47443 counter reject with tcp reset
		ip saddr 169.254.0.0/16 tcp dport @repositorio accept
		ip saddr . tcp dport @repositorio_lan accept
		tcp dport 80 counter reject with tcp reset
		ip saddr @ssh_redes tcp dport 22 accept
		tcp dport 22 counter reject with tcp reset
	}

	chain saida {
		type filter hook output priority filter; policy accept;
		meta skuid "msscan-web" jump navegador
		meta skuid != "msscan-ui" accept
		oifname "lo" tcp dport 47480 counter reject with tcp reset
		oifname "lo" ip daddr 127.0.0.0/8 accept
		oifname "lo" ip6 daddr ::1 accept
		meta l4proto tcp counter reject with tcp reset
		counter reject
	}

	chain navegador {
		oifname "lo" ip daddr 127.0.0.1 tcp dport { 47480, 8765 } accept
		meta l4proto tcp counter reject with tcp reset
		counter reject
	}
}
